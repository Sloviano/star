# R8 keep rules. AGP combines every file in src/main/keepRules and passes them to R8.
#
# Most dependencies here ship their own consumer rules inside their AAR/JAR (Room, OkHttp, ML Kit,
# gRPC's transport). What follows covers the two libraries whose Android artifacts rely on
# reflection over names R8 would otherwise rewrite, plus the app's own reflective entry points.

# --- protobuf-lite (Module 1: the dish gRPC stubs) ---
# GeneratedMessageLite decodes wire data through RawMessageInfo, which names each field as a string
# and looks it up reflectively. Renaming or removing those fields makes every dish response come
# back empty at runtime — with no exception, which is the worst possible failure here: the app would
# simply never read a dish ID in the field.
-keepclassmembers class * extends com.google.protobuf.GeneratedMessageLite {
    <fields>;
}
-keepclassmembers class * extends com.google.protobuf.GeneratedMessageLite {
    ** newBuilder();
    ** getDefaultInstance();
}
# The generated *OrBuilder interfaces and the dynamic-method machinery.
-keep class com.google.protobuf.** { *; }
-dontwarn com.google.protobuf.**
# Our own generated stubs (device_min.proto -> spacex.api.device.*).
-keep class spacex.api.device.** { *; }

# --- gRPC ---
# Transport and codec are picked up through ServiceLoader / reflection.
-keep class io.grpc.** { *; }
-dontwarn io.grpc.**
# grpc-okhttp and grpc-stub reference optional Android/JDK classes that aren't on this classpath.
-dontwarn javax.naming.**
-dontwarn org.codehaus.mojo.animal_sniffer.**
-dontwarn javax.annotation.**

# --- kotlinx.serialization (Module 5: the upload DTOs) ---
# The compiler plugin generates a Companion.serializer() per @Serializable class, reached
# reflectively. If it is stripped, uploads fail to encode and records never leave the phone.
-keepattributes *Annotation*, InnerClasses
-dontnote kotlinx.serialization.**
-keepclassmembers class kotlinx.serialization.json.** {
    *** Companion;
}
-keepclasseswithmembers class kotlinx.serialization.json.** {
    kotlinx.serialization.KSerializer serializer(...);
}
-keep,includedescriptorclasses class com.starlink.scanner.**$$serializer { *; }
-keepclassmembers class com.starlink.scanner.** {
    *** Companion;
    *** INSTANCE;
    kotlinx.serialization.KSerializer serializer(...);
}

# --- ML Kit component discovery ---
# MlKitInitProvider reads the registrar class names out of the merged manifest and instantiates each
# by reflection, so both the names and their no-arg constructors must survive. Keeping the class
# alone is not enough: R8 full mode drops the constructor and every ML Kit feature then fails with an
# NPE deep inside getClient(), long after the real cause. Kept explicitly so this holds even if
# android.enableR8.fullMode is turned back on.
-keep class * implements com.google.firebase.components.ComponentRegistrar {
    <init>();
}
-keep class com.google.mlkit.common.internal.MlKitInitProvider { <init>(); }
-keep class com.google.mlkit.common.internal.MlKitComponentDiscoveryService { <init>(); }

# --- App entry points constructed reflectively by the platform ---
# WorkManager instantiates workers by class name.
-keep class com.starlink.scanner.data.upload.UploadWorker { <init>(...); }
# Room reads the generated implementation and the entity's fields.
-keep class com.starlink.scanner.data.local.** { *; }
# BuildConfig holds the endpoint, token and repo the app reads at runtime.
-keep class com.starlink.scanner.BuildConfig { *; }
